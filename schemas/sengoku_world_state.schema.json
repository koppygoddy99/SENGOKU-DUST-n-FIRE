{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sengoku/world-state.schema.json",
  "title": "Sengoku World State",
  "description": "Schema proposal for an event-sourced Sengoku RPG world state. Historical claims, inferences, rumors, and game inventions must carry provenance and confidence.",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "world_snapshot",
    "factions",
    "relationships",
    "incidents",
    "heat_tracks",
    "seasonal_states",
    "markets",
    "npc_memories",
    "context_summaries",
    "event_log"
  ],
  "unevaluatedProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "run_id": {
      "$ref": "#/$defs/id"
    },
    "world_snapshot": {
      "$ref": "#/$defs/worldSnapshot"
    },
    "factions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/faction"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship"
      }
    },
    "incidents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/incident"
      }
    },
    "heat_tracks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/heatTrack"
      }
    },
    "seasonal_states": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/seasonalState"
      }
    },
    "markets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/market"
      }
    },
    "npc_memories": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/npcMemory"
      }
    },
    "context_summaries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/contextSummary"
      }
    },
    "event_log": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9_:.\\-]+$"
    },
    "date": {
      "type": "string",
      "pattern": "^-?[0-9]{1,4}-[0-9]{2}-[0-9]{2}$"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "confidenceLabel": {
      "type": "string",
      "enum": [
        "confirmed",
        "supported",
        "contested",
        "weak_or_legend",
        "game_invention",
        "unknown"
      ]
    },
    "knowledgeType": {
      "type": "string",
      "enum": [
        "fact",
        "belief",
        "rumor",
        "unknown"
      ]
    },
    "scopeType": {
      "type": "string",
      "enum": [
        "npc",
        "household",
        "village",
        "settlement",
        "gate",
        "province",
        "route",
        "faction",
        "world"
      ]
    },
    "provenance": {
      "type": "object",
      "required": [
        "kind",
        "confidence_label"
      ],
      "unevaluatedProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "historical_source",
            "observed_event",
            "derived_projection",
            "npc_report",
            "rumor",
            "game_rule",
            "game_invention"
          ]
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "source_title": {
          "type": "string"
        },
        "source_event_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "confidence_label": {
          "$ref": "#/$defs/confidenceLabel"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "baseRecord": {
      "type": "object",
      "required": [
        "schema_version",
        "created_at",
        "updated_at",
        "provenance"
      ],
      "properties": {
        "schema_version": {
          "type": "string"
        },
        "created_at": {
          "$ref": "#/$defs/date"
        },
        "updated_at": {
          "$ref": "#/$defs/date"
        },
        "valid_from": {
          "$ref": "#/$defs/date"
        },
        "valid_to": {
          "$ref": "#/$defs/date"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "source_event_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "worldSnapshot": {
      "allOf": [
        {
          "$ref": "#/$defs/baseRecord"
        },
        {
          "type": "object",
          "required": [
            "world_id",
            "run_id",
            "current_date",
            "calendar_system",
            "current_season",
            "current_province_id"
          ],
          "properties": {
            "world_id": {
              "$ref": "#/$defs/id"
            },
            "run_id": {
              "$ref": "#/$defs/id"
            },
            "current_date": {
              "$ref": "#/$defs/date"
            },
            "calendar_system": {
              "type": "string",
              "enum": [
                "japanese_lunisolar",
                "gregorian_game_clock",
                "unknown"
              ]
            },
            "current_era_name": {
              "type": "string"
            },
            "current_season": {
              "type": "string",
              "enum": [
                "late_winter",
                "spring",
                "rainy_season",
                "summer",
                "early_autumn",
                "late_autumn",
                "winter",
                "unknown"
              ]
            },
            "current_province_id": {
              "$ref": "#/$defs/id"
            },
            "active_route_ids": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              }
            },
            "projection_version": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "faction": {
      "allOf": [
        {
          "$ref": "#/$defs/baseRecord"
        },
        {
          "type": "object",
          "required": [
            "faction_id",
            "name",
            "faction_type",
            "interests",
            "known_region_ids"
          ],
          "properties": {
            "faction_id": {
              "$ref": "#/$defs/id"
            },
            "name": {
              "type": "string"
            },
            "name_jp": {
              "type": "string"
            },
            "faction_type": {
              "type": "string",
              "enum": [
                "daimyo_house",
                "vassal_house",
                "kokujin",
                "jizamurai_league",
                "village_league",
                "temple",
                "shrine",
                "merchant_council",
                "guild",
                "port_group",
                "military_unit",
                "bandit_group",
                "religious_league",
                "foreign_trade_group",
                "other"
              ]
            },
            "interests": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "resources": {
              "type": "object",
              "additionalProperties": {
                "type": "number"
              }
            },
            "hierarchy_parent_id": {
              "$ref": "#/$defs/id"
            },
            "known_region_ids": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              }
            },
            "policy": {
              "type": "object",
              "additionalProperties": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              }
            },
            "visibility": {
              "type": "string",
              "enum": [
                "public",
                "partial",
                "secret"
              ]
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "scores": {
      "type": "object",
      "unevaluatedProperties": false,
      "properties": {
        "trust": {
          "type": "number",
          "minimum": -100,
          "maximum": 100
        },
        "respect": {
          "type": "number",
          "minimum": -100,
          "maximum": 100
        },
        "fear": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "debt": {
          "type": "number",
          "minimum": -100,
          "maximum": 100
        },
        "resentment": {
          "type": "number",
          "minimum": -100,
          "maximum": 100
        },
        "reliability": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "relationship": {
      "allOf": [
        {
          "$ref": "#/$defs/baseRecord"
        },
        {
          "type": "object",
          "required": [
            "relationship_id",
            "subject_id",
            "target_id",
            "scope",
            "scores",
            "stance"
          ],
          "properties": {
            "relationship_id": {
              "$ref": "#/$defs/id"
            },
            "subject_id": {
              "$ref": "#/$defs/id"
            },
            "target_id": {
              "$ref": "#/$defs/id"
            },
            "scope": {
              "type": "object",
              "required": [
                "scope_type"
              ],
              "unevaluatedProperties": false,
              "properties": {
                "scope_type": {
                  "$ref": "#/$defs/scopeType"
                },
                "province_id": {
                  "$ref": "#/$defs/id"
                },
                "settlement_id": {
                  "$ref": "#/$defs/id"
                },
                "gate_id": {
                  "$ref": "#/$defs/id"
                }
              }
            },
            "scores": {
              "$ref": "#/$defs/scores"
            },
            "stance": {
              "type": "string",
              "enum": [
                "allied",
                "friendly",
                "helpful",
                "neutral",
                "cautious_cooperation",
                "interfering",
                "hostile",
                "war",
                "unknown"
              ]
            },
            "last_changed_at": {
              "$ref": "#/$defs/date"
            },
            "visible_to": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "incident": {
      "allOf": [
        {
          "$ref": "#/$defs/baseRecord"
        },
        {
          "type": "object",
          "required": [
            "incident_id",
            "incident_type",
            "occurred_at",
            "visibility",
            "severity"
          ],
          "properties": {
            "incident_id": {
              "$ref": "#/$defs/id"
            },
            "incident_type": {
              "type": "string",
              "enum": [
                "theft",
                "violence",
                "murder",
                "smuggling",
                "forgery",
                "tax_evasion",
                "aid",
                "betrayal",
                "rumor_spread",
                "battle",
                "other"
              ]
            },
            "occurred_at": {
              "$ref": "#/$defs/date"
            },
            "province_id": {
              "$ref": "#/$defs/id"
            },
            "settlement_id": {
              "$ref": "#/$defs/id"
            },
            "actor_ids": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              }
            },
            "visibility": {
              "type": "string",
              "enum": [
                "hidden",
                "witnessed",
                "suspected",
                "public",
                "documented"
              ]
            },
            "severity": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5
            },
            "witness_count": {
              "type": "integer",
              "minimum": 0
            },
            "evidence_strength": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "identity_confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "affected_faction_ids": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              }
            },
            "effects": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "target_id",
                  "delta_type"
                ],
                "unevaluatedProperties": false,
                "properties": {
                  "target_id": {
                    "$ref": "#/$defs/id"
                  },
                  "delta_type": {
                    "type": "string"
                  },
                  "delta": {
                    "type": "number"
                  }
                }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "heatTrack": {
      "allOf": [
        {
          "$ref": "#/$defs/baseRecord"
        },
        {
          "type": "object",
          "required": [
            "heat_track_id",
            "scope",
            "status",
            "level",
            "last_incident_ids"
          ],
          "properties": {
            "heat_track_id": {
              "$ref": "#/$defs/id"
            },
            "subject_id": {
              "$ref": "#/$defs/id"
            },
            "scope": {
              "type": "object",
              "required": [
                "scope_type"
              ],
              "unevaluatedProperties": false,
              "properties": {
                "scope_type": {
                  "$ref": "#/$defs/scopeType"
                },
                "province_id": {
                  "$ref": "#/$defs/id"
                },
                "settlement_id": {
                  "$ref": "#/$defs/id"
                },
                "gate_id": {
                  "$ref": "#/$defs/id"
                },
                "faction_id": {
                  "$ref": "#/$defs/id"
                }
              }
            },
            "status": {
              "type": "string",
              "enum": [
                "unseen",
                "suspected",
                "identified",
                "wanted",
                "archived"
              ]
            },
            "level": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5
            },
            "incident_severity": {
              "type": "number",
              "minimum": 0,
              "maximum": 5
            },
            "witness_count": {
              "type": "integer",
              "minimum": 0
            },
            "evidence_strength": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "identity_confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "communication_speed": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "search_budget": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "border_control": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "political_priority": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "last_incident_ids": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              }
            },
            "decay_rule": {
              "type": "string"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "seasonalState": {
      "allOf": [
        {
          "$ref": "#/$defs/baseRecord"
        },
        {
          "type": "object",
          "required": [
            "seasonal_state_id",
            "scope",
            "date",
            "crop_phase",
            "food_stock",
            "labor_availability",
            "road_condition",
            "river_level",
            "sea_state",
            "disease_risk",
            "war_readiness",
            "market_pressure"
          ],
          "properties": {
            "seasonal_state_id": {
              "$ref": "#/$defs/id"
            },
            "scope": {
              "type": "object",
              "required": [
                "scope_type"
              ],
              "unevaluatedProperties": false,
              "properties": {
                "scope_type": {
                  "type": "string",
                  "enum": [
                    "province",
                    "route",
                    "market"
                  ]
                },
                "province_id": {
                  "$ref": "#/$defs/id"
                },
                "route_id": {
                  "$ref": "#/$defs/id"
                },
                "market_id": {
                  "$ref": "#/$defs/id"
                }
              }
            },
            "date": {
              "$ref": "#/$defs/date"
            },
            "calendar_system": {
              "type": "string",
              "enum": [
                "japanese_lunisolar",
                "gregorian_game_clock",
                "unknown"
              ]
            },
            "lunar_month": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 13
            },
            "crop_phase": {
              "type": "string",
              "enum": [
                "fallow",
                "preparation",
                "nursery",
                "transplanting",
                "growing",
                "harvest",
                "post_harvest",
                "unknown"
              ]
            },
            "food_stock": {
              "type": "number",
              "minimum": 0
            },
            "labor_availability": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "road_condition": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "river_level": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "sea_state": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "disease_risk": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "war_readiness": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "market_pressure": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "reason_codes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "market": {
      "allOf": [
        {
          "$ref": "#/$defs/baseRecord"
        },
        {
          "type": "object",
          "required": [
            "market_id",
            "province_id",
            "goods",
            "route_ids"
          ],
          "properties": {
            "market_id": {
              "$ref": "#/$defs/id"
            },
            "province_id": {
              "$ref": "#/$defs/id"
            },
            "settlement_id": {
              "$ref": "#/$defs/id"
            },
            "goods": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "item_id",
                  "stock",
                  "price_band",
                  "trend"
                ],
                "unevaluatedProperties": false,
                "properties": {
                  "item_id": {
                    "$ref": "#/$defs/id"
                  },
                  "stock": {
                    "type": "number",
                    "minimum": 0
                  },
                  "price_band": {
                    "type": "string",
                    "enum": [
                      "very_low",
                      "low",
                      "normal",
                      "high",
                      "scarce",
                      "unknown"
                    ]
                  },
                  "price_basis": {
                    "type": "string"
                  },
                  "trend": {
                    "type": "string",
                    "enum": [
                      "falling",
                      "stable",
                      "rising",
                      "volatile",
                      "unknown"
                    ]
                  },
                  "provenance": {
                    "$ref": "#/$defs/provenance"
                  }
                }
              }
            },
            "route_ids": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              }
            },
            "controlling_faction_ids": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "npcMemory": {
      "allOf": [
        {
          "$ref": "#/$defs/baseRecord"
        },
        {
          "type": "object",
          "required": [
            "memory_id",
            "actor_id",
            "memory_type",
            "summary",
            "salience",
            "confidence",
            "scope",
            "visibility"
          ],
          "properties": {
            "memory_id": {
              "$ref": "#/$defs/id"
            },
            "actor_id": {
              "$ref": "#/$defs/id"
            },
            "memory_type": {
              "$ref": "#/$defs/knowledgeType"
            },
            "summary": {
              "type": "string"
            },
            "salience": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "confidence": {
              "$ref": "#/$defs/confidence"
            },
            "scope": {
              "type": "object",
              "required": [
                "scope_type"
              ],
              "unevaluatedProperties": false,
              "properties": {
                "scope_type": {
                  "$ref": "#/$defs/scopeType"
                },
                "province_id": {
                  "$ref": "#/$defs/id"
                },
                "settlement_id": {
                  "$ref": "#/$defs/id"
                }
              }
            },
            "visibility": {
              "type": "string",
              "enum": [
                "private",
                "shared",
                "public",
                "gm_only"
              ]
            },
            "decay_rate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "source_event_ids": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              }
            },
            "contradiction_ids": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "contextSummary": {
      "allOf": [
        {
          "$ref": "#/$defs/baseRecord"
        },
        {
          "type": "object",
          "required": [
            "context_summary_id",
            "scope",
            "time_window",
            "layers",
            "token_estimate"
          ],
          "properties": {
            "context_summary_id": {
              "$ref": "#/$defs/id"
            },
            "scope": {
              "type": "object",
              "required": [
                "scope_type"
              ],
              "unevaluatedProperties": false,
              "properties": {
                "scope_type": {
                  "$ref": "#/$defs/scopeType"
                },
                "province_id": {
                  "$ref": "#/$defs/id"
                },
                "faction_id": {
                  "$ref": "#/$defs/id"
                },
                "actor_id": {
                  "$ref": "#/$defs/id"
                }
              }
            },
            "time_window": {
              "type": "object",
              "required": [
                "from",
                "to"
              ],
              "unevaluatedProperties": false,
              "properties": {
                "from": {
                  "$ref": "#/$defs/date"
