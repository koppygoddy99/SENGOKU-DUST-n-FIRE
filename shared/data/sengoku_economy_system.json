  "auto_conversion_rules": {
    "enabled": true,
    "player_never_manual_convert": true,
    "conversion_directions": {
      "upward": {
        "description": "System auto-converts copper to silver to gold when needed for high-tier purchases",
        "mon_to_monme_threshold": 1000,
        "monme_to_ryo_threshold": 4,
        "rounding": "floor",
        "loss_rate": 0.0,
        "animation": "coins shimmer and reform into larger ingot"
      },
      "downward": {
        "description": "System auto-breaks gold/silver into smaller units when making small purchases",
        "loss_rate": 0.0,
        "animation": "ingot shatters into coins"
      }
    },
    "shop_display_logic": {
      "if_player_has_tier": "show price in Mon with tier-color",
      "if_player_lacks_tier": "show 'Requires higher denomination' or offer barter/warifu",
      "example": "Sword 500 Mon (🥈 Silver) → if player has 500 copper, shop says 'We don't take copper for this.'"
    }
  },
  "weight_system": {
    "enabled": true,
    "display_in_ui": true,
    "weight_per_1000_mon_kg": 3.75,
    "tiers_affected_by_weight": [
