{
  "_schema_version": "1.0.0",
  "_game": "Sengoku: Dust & Fire",
  "_description": "Unified currency display (Mon) with hidden 3-tier backend. Auto-conversion, weight, barter, warifu, and domain variance.",
  "metadata": {
    "design_principles": [
      "Player sees ONE currency: Mon (文). Backend manages 3 tiers silently.",
      "Auto-conversion: system handles tier-upgrades, player never clicks 'exchange'.",
      "Tier is felt through: shop rejection, color/icon, weight, NPC attitude, rumor.",
      "Barter and Warifu exist as ALTERNATIVES to cash, not replacements.",
      "Every price = base_price * domain_index * season * political * rumor_factor"
    ],
    "historical_era": "Sengoku period (1467-1615)",
    "currency_display_unit": "Mon",
    "currency_display_symbol": "文",
    "volume_units": {
      "koku": {
        "liters": 180.39,
        "kg_rice": 150,
        "sho_per_koku": 10,
        "note": "Standard tax/volume unit"
      },
      "to": {
        "liters": 18.04,
        "note": "1/10 koku"
      },
      "sho": {
        "liters": 1.804,
        "note": "Standard sho. Kai-sho was 5.39L (3x)"
      },
      "go": {
        "liters": 0.1804,
        "note": "1/10 sho"
      },
      "shaku": {
        "volume_ml": 18.04,
        "note": "Small volume measure, also used for miso/salt rations"
      }
    },
    "weight_units": {
      "kan_weight": {
        "grams": 3750,
        "note": "Weight of 1,000 copper mon coins"
      },
      "mon_per_kg": 267,
      "carry_capacity_warning": "Over 3 kan (11.25kg) slows movement, over 10 kan (37.5kg) prevents running"
    }
  },
